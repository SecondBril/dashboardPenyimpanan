# ==============================================================================
# Multi-Cloud Storage Hub - Environment Variables Template (.env.example)
# ==============================================================================
# Petunjuk Penggunaan:
# 1. Salin file ini menjadi .env.local:
#    cp .env.example .env.local
# 2. Isi nilai variabel sesuai konfigurasi akun Anda.
# 3. Mode default adalah 'mock' (siap dicoba langsung tanpa kredensial API asli).
#    Ubah NEXT_PUBLIC_APP_MODE=production jika ingin terhubung ke API asli.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CONFIGURATION & MODE
# ------------------------------------------------------------------------------
# Mode aplikasi:
# - 'mock'       : Menggunakan simulasi adapter lokal (tanpa perlu API key asli)
# - 'production' : Terhubung langsung ke Google Drive API v3 & Microsoft Graph
NEXT_PUBLIC_APP_MODE=mock
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database, Metadata File Index, & Transfer Queue)
# ------------------------------------------------------------------------------
# Dapatkan dari Dashboard Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. MASTER TOKEN ENCRYPTION KEY (Security)
# ------------------------------------------------------------------------------
# Kunci enkripsi AES-256 (panjang 32 karakter acak) untuk enkripsi token at-rest
TOKEN_ENCRYPTION_SECRET=generate-a-random-32-char-secret-key-here

# ------------------------------------------------------------------------------
# 4. GOOGLE DRIVE API (OAuth 2.0 untuk 3 Akun Google Drive)
# ------------------------------------------------------------------------------
# Dibuat melalui Google Cloud Console (https://console.cloud.google.com/):
# - Aktifkan 'Google Drive API' (v3)
# - Buat OAuth 2.0 Client ID (Application type: Web application)
# - Masukkan Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Refresh Token untuk masing-masing dari 3 akun Google Drive (sesuai UUID default):
# Akun A - Google Drive A (Utama / work.drive@gmail.com):
GOOGLE_REFRESH_TOKEN_a0000000-0000-0000-0000-000000000001=your-refresh-token-account-a

# Akun B - Google Drive B (Media / media.vault@gmail.com):
GOOGLE_REFRESH_TOKEN_a0000000-0000-0000-0000-000000000002=your-refresh-token-account-b

# Akun C - Google Drive C (Arsip / archive.backup@gmail.com):
GOOGLE_REFRESH_TOKEN_a0000000-0000-0000-0000-000000000003=your-refresh-token-account-c

# Fallback global Google refresh token (digunakan jika token per-ID spesifik tidak disetel):
GOOGLE_REFRESH_TOKEN=your-fallback-google-refresh-token

# ------------------------------------------------------------------------------
# 5. MICROSOFT ONEDRIVE (Microsoft Graph API OAuth 2.0 / Azure Entra ID)
# ------------------------------------------------------------------------------
# Daftarkan aplikasi di Azure Portal (https://portal.azure.com/) / Microsoft Entra ID:
# - Authentication: Web platform, Redirect URI: http://localhost:3000/api/auth/callback/microsoft
# - API Permissions: Microsoft Graph -> Delegated permissions (Files.ReadWrite.All, offline_access, User.Read)
# - Certificates & Secrets: Buat New client secret
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/callback/microsoft

# Tenant ID:
# - 'common' atau 'consumers' untuk akun Microsoft Personal (Outlook, Hotmail, Live)
# - Gunakan Tenant ID / Directory ID spesifik jika menggunakan akun institusi/organisasi (Work/School)
MICROSOFT_TENANT_ID=common

# Kredensial Autentikasi OneDrive (Bisa menggunakan Access Token langsung ATAU Refresh Token):
# 1. MICROSOFT_ACCESS_TOKEN: Access token langsung (berlaku ~1 jam)
MICROSOFT_ACCESS_TOKEN=your-microsoft-access-token

# 2. MICROSOFT_REFRESH_TOKEN: Refresh token jangka panjang (untuk auto-refresh token tanpa expired)
MICROSOFT_REFRESH_TOKEN=your-microsoft-refresh-token

# ------------------------------------------------------------------------------
# 6. GOOGLE GEMINI AI (Smart Classifier & Auto-Organization)
# ------------------------------------------------------------------------------
# Dapatkan API Key gratis di Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# 7. TELEGRAM BOT NOTIFICATIONS (Opsional)
# ------------------------------------------------------------------------------
# Dapatkan bot token dari @BotFather dan Chat ID akun Anda dari @userinfobot di Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
